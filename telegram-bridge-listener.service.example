[Unit]
Description=Telegram bridge listener (long-poll getUpdates into local inbox queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User= is REQUIRED: without it the service runs as root while the
# agent runs as <USER>, and the agent then cannot write the shared
# state files (thinking placeholder, rate limits) and replies fail.
User=<USER>
# Replace <KIT_DIR> with the kit's absolute path and <USER> with the
# user the bridge runs as. The token lives in a chmod-600 env file:
#   TELEGRAM_BOT_TOKEN=<token from @BotFather>
#   TGBRIDGE_HOME=<KIT_DIR>          (optional; defaults to the kit root)
EnvironmentFile=<KIT_DIR>/bridge.env
ExecStart=/usr/bin/env python3 "<KIT_DIR>/telegram_bridge/listener.py"
WorkingDirectory=<KIT_DIR>
# %h is the User='s home as systemd resolves it — do NOT hardcode
# /home/<USER>: homes also live in /Users, /root, or custom paths, and
# a wrong HOME makes the listener write state to the wrong place.
Environment=HOME=%h
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
