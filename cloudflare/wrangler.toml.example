# Copy to wrangler.toml and fill in your own IDs.
# Order matters:  1) npx wrangler deploy
#                 2) npx wrangler secret put ADMIN_TOKEN   (long random value;
#                    secret put fails before the first deploy)

name = "bot-shared-state"
main = "worker.js"
compatibility_date = "2026-01-01"

[[d1_databases]]
binding = "DB"
database_name = "bot-shared"
database_id = "<your-d1-database-id>"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "bot-shared-files"
